# Copy to .env.local (local development) or set in Vercel (Project → Settings → Environment Variables).
# Never commit real values. Server-only values must never start with NEXT_PUBLIC_.

# --- App -----------------------------------------------------------------------------------------------------
# Where the app is served: http://localhost:3300 locally, https://your-domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3300

# --- Supabase ------------------------------------------------------------------------------------------------
# Local: from `supabase status` (the API runs on http://127.0.0.1:56321).
# Hosted: Project Settings → API keys (https://<project-ref>.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security: used for storage, issuing PDFs and payments.
SUPABASE_SECRET_KEY=

# --- Sign-in -------------------------------------------------------------------------------------------------
# Cloudflare Turnstile on sign-in. The secret key goes into Supabase (Authentication → Attack Protection → Captcha);
# locally the CLI reads TURNSTILE_SECRET_KEY for supabase/config.toml. Leave the site key empty to hide the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# "true" shows "Continue with Google". Configure the Google provider in Supabase (Authentication → Providers);
# locally the CLI reads these two for supabase/config.toml.
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Letter content --------------------------------------------------------------------------------------------
# "true" lets draft (unreviewed) clauses be used, with an "Unreviewed wording" banner. Only honoured against a
# local Supabase stack (127.0.0.1 / localhost); hosted environments always use approved clauses only.
ALLOW_UNREVIEWED_CLAUSES=true

# --- PDFs ----------------------------------------------------------------------------------------------------
# Server only. Signs the one-minute links headless Chrome uses to open a letter for printing. 32+ random
# characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RENDER_TOKEN_SECRET=
# Optional. A local Chrome for PDFs (macOS defaults to /Applications/Google Chrome.app). Linux and Vercel use
# @sparticuz/chromium and ignore this when it's empty.
CHROME_EXECUTABLE_PATH=
# Optional. Where headless Chrome opens the print page; defaults to the Vercel deployment URL, then
# NEXT_PUBLIC_APP_URL.
RENDER_BASE_URL=
